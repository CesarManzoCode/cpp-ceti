// =====================================================================
//  ACADÉMICO — campus, programa, oferta (catálogo CETI)
// =====================================================================

model AcademicCampus {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  offerings AcademicOffering[]

  @@map("academic_campus")
}

model AcademicProgram {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  active Boolean @default(true)

  offerings AcademicOffering[]

  @@map("academic_program")
}

/// Combinación real campus×programa que el CETI ofrece hoy. UNIQUE evita
/// combinaciones inventadas por el cliente: sólo se puede elegir una oferta
/// que exista en este catálogo.
model AcademicOffering {
  id            String  @id @default(cuid())
  campusId      String
  campus        AcademicCampus  @relation(fields: [campusId], references: [id], onDelete: Restrict)
  programId     String
  program       AcademicProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  semesterCount Int
  active        Boolean @default(true)

  users User[]

  @@unique([campusId, programId])
  @@map("academic_offering")
}

// =====================================================================
//  RATE LIMITING
// =====================================================================
//  Reemplaza el rate-limit en memoria de /api/run y de las acciones de
//  envío de ejercicios. Persistente y multi-instancia (serverless safe).
//  Estrategia: ventana fija — un row por (usuario, endpoint, minuto-utc).
//  Limpieza: las filas viejas se pueden purgar con un job; mientras tanto
//  son baratas (índice por windowStart).

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String // "run" | "submit-lesson-exercise" | "submit-practice"
  windowStart DateTime // truncado al inicio de la ventana (minuto)
  count       Int      @default(1)

  @@unique([userId, endpoint, windowStart])
  @@index([windowStart])
  @@map("rate_limit")
}
