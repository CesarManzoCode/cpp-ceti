// =====================================================================
// C++ CETI — Schema de la base de datos
// =====================================================================
//   Stack: PostgreSQL (Supabase) + Prisma + Better Auth
//   Diseño: Curso → Unidad → Lección → Paso. Progreso por usuario.
// =====================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
//  AUTH (Better Auth — sigue el schema oficial)
// =====================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  /// Handle público estable (lowercase, [a-z0-9_], 3-20 chars). Identifica al usuario
  /// en URLs (`/app/perfil/<username>`) y para búsqueda de amigos. Inmutable después
  /// del primer set (no hay UI para cambiarlo; preserva enlaces de invitación).
  username      String   @unique
  /// Bio opcional mostrada en el perfil público. Texto plano.
  bio           String?  @db.VarChar(160)
  image         String?
  /// Rol de producto. `admin` habilita /app/admin (analytics + triage de
  /// reportes). La autorización SIEMPRE se resuelve leyendo esta columna en
  /// el servidor (`requireAdmin`), nunca desde el payload de la sesión.
  role          UserRole @default(student)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relaciones de auth
  sessions Session[]
  accounts Account[]

  // Relaciones de progreso
  courseProgress      UserCourseProgress[]
  lessonProgress      UserLessonProgress[]
  stepProgress        UserStepProgress[]
  exerciseAttempts    UserExerciseAttempt[]
  exerciseCompletions UserExerciseCompletion[]
  practiceAttempts    UserPracticeAttempt[]
  practiceCompletions UserPracticeCompletion[]
  hintsViewed         UserHintViewed[]
  studySessions       StudySession[]
  bugReports          BugReport[]              @relation("BugReportAuthor")
  handledBugReports   BugReport[]              @relation("BugReportHandler")
  feedback            Feedback[]               @relation("FeedbackAuthor")
  handledFeedback     Feedback[]               @relation("FeedbackHandler")
  productEvents       ProductEvent[]
  streak              UserStreak?

  // Relaciones sociales
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  @@index([email])
  /// Altas por ventana temporal en el panel interno.
  @@index([createdAt])
  @@map("user")
}

enum UserRole {
  student
  admin
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =====================================================================
//  CONTENIDO: Curso > Unidad > Lección > Paso
// =====================================================================

/// Lenguajes de programación soportados por la plataforma. Es un enum porque
/// el conjunto lo controla la operación, no el usuario: agregar uno exige
/// migración, contenido, capacidad del proveedor y diagnósticos.
enum ProgrammingLanguage {
  cpp
  csharp
}

model Course {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  description      String
  /// Materia académica tal como aparece en el plan de estudios del CETI.
  subjectName      String
  /// Contexto académico visible (programa, semestre, horas).
  academicContext  String
  /// Lenguaje del curso. FUENTE DE VERDAD del editor, los fences, los
  /// diagnósticos y el agrupamiento de analytics. Nunca se infiere del slug.
  language         ProgrammingLanguage
  /// Perfil de ejecución (lenguaje + toolchain + versión) con el que se
  /// compila y califica TODO recurso de este curso. El servidor lo deriva del
  /// curso del recurso; el cliente jamás lo elige. Validado contra
  /// `src/lib/code-languages` en el seed y al resolver cada ejecución.
  executionProfile String
  order            Int                 @default(0)
  published        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  units             Unit[]
  progress          UserCourseProgress[]
  practiceExercises PracticeExercise[]

  @@map("course")
}

model Unit {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  order       Int      @default(0)
  icon        String? // emoji o nombre de icono lucide
  colorAccent String? // hex opcional para card de la unidad
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons           Lesson[]
  practiceExercises PracticeExercise[]

  @@unique([courseId, slug])
  @@index([courseId, order])
  @@map("unit")
}

model Lesson {
  id                String    @id @default(cuid())
  unitId            String
  unit              Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  description       String
  order             Int       @default(0)
  xpReward          Int       @default(20)
  estimatedMinutes  Int       @default(5)
  published         Boolean   @default(true)
  /// Hash corto derivado de las revisiones de sus pasos: cambia cuando cambia
  /// CUALQUIER paso de la lección. Permite comparar funnels antes/después de
  /// una reescritura. Lo escribe el seed.
  contentRevision   String?
  contentRevisionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  steps         LessonStep[]
  progress      UserLessonProgress[]
  feedback      Feedback[]
  productEvents ProductEvent[]

  @@unique([unitId, slug])
  @@index([unitId, order])
  @@map("lesson")
}

// Cada paso de una lección. El campo `content` es un JSON cuya estructura
// depende del `type`. Esto permite añadir tipos nuevos sin migraciones.
//
// Tipos soportados (TypeScript valida la forma):
//  - theory        — { markdown: string, mediaUrl?: string }
//  - code_example  — { code: string, explanation: string, runnable: boolean }
//  - quiz          — { question, options[], correctIndex, explanation }
//  - fill_blank    — { template: string, blanks: {answer, hint?}[] }
//  - code_challenge — referencia a un Exercise
model LessonStep {
  id        String         @id @default(cuid())
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  order     Int
  type      LessonStepType
  content   Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  /// Hash corto del contenido pedagógico vigente (ver `src/lib/content-revision.ts`).
  /// Lo escribe el seed. Los eventos y los intentos guardan la revisión que el
  /// alumno tenía enfrente, para poder comparar antes/después de un cambio.
  contentRevision   String?
  contentRevisionAt DateTime?

  exercise      Exercise?
  progress      UserStepProgress[]
  bugReports    BugReport[]
  productEvents ProductEvent[]

  @@unique([lessonId, order])
  @@index([lessonId, order])
  @@map("lesson_step")
}

enum LessonStepType {
  theory
  code_example
  quiz
  fill_blank
  code_challenge
  matching
  code_completion
}

model Exercise {
  id                String                   @id @default(cuid())
  stepId            String                   @unique
  step              LessonStep               @relation(fields: [stepId], references: [id], onDelete: Cascade)
  prompt            String // descripción del reto en MD
  starterCode       String // código pre-cargado en el editor
  solutionCode      String // referencia (no se muestra al user)
  hints             String[] // pistas progresivas
  difficulty        Difficulty               @default(easy)
  xpReward          Int                      @default(15)
  testCases         TestCase[]
  attempts          UserExerciseAttempt[]
  completions       UserExerciseCompletion[]
  hintsViewed       UserHintViewed[]
  bugReports        BugReport[]
  productEvents     ProductEvent[]
  /// Hash corto del contenido vigente (prompt + starter + solución + hints +
  /// tests). Lo escribe el seed; ver `src/lib/content-revision.ts`.
  contentRevision   String?
  contentRevisionAt DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@map("exercise")
}

enum Difficulty {
  easy
  medium
  hard
}

model TestCase {
  id             String   @id @default(cuid())
  exerciseId     String
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // stdin que se enviará al programa; "" si el ejercicio no lee entrada
  stdin          String   @default("")
  // stdout esperado; comparación por strip(==) por defecto
  expectedStdout String
  // Si true, el test se ve en la UI antes de enviar (visible). Si false, oculto.
  visible        Boolean  @default(true)
  description    String?
  order          Int      @default(0)

  @@index([exerciseId, order])
  @@map("test_case")
}

// =====================================================================
//  PROGRESO DEL USUARIO
// =====================================================================

model UserCourseProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
  @@map("user_course_progress")
}

model UserLessonProgress {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      LessonProgressStatus @default(in_progress)
  xpEarned    Int                  @default(0)
  startedAt   DateTime             @default(now())
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([userId, status])
  /// Funnel de lecciones: completadas dentro de una ventana.
  @@index([status, completedAt])
  @@map("user_lesson_progress")
}

enum LessonProgressStatus {
  not_started
  in_progress
  completed
}

model UserStepProgress {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId          String
  step            LessonStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedAt     DateTime   @default(now())
  /// ⚠️ NO es "intentos del estudiante". Cuenta cuántas veces `completeStep`
  /// marcó este paso (avanzar, volver atrás y volver a avanzar lo incrementa).
  /// Los intentos pedagógicos reales viven en `ProductEvent.lesson_step_attempt`
  /// (steps interactivos) y en `UserExerciseAttempt` (retos de código).
  completionCount Int        @default(1)

  @@unique([userId, stepId])
  @@map("user_step_progress")
}

model UserExerciseAttempt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  code            String
  passed          Boolean
  feedback        String? // resumen del por qué pasó o falló
  testsPassed     Int      @default(0)
  testsTotal      Int      @default(0)
  /// ⚠️ LATENCIA DEL EJECUTOR (compilar + correr todos los tests), en ms.
  /// NO es el tiempo que el alumno tardó en resolver. Para tiempo de estudio
  /// usa `StudySession.engagedMs`. Ver `docs/product-analytics.md`.
  durationMs      Int?
  /// Revisión del contenido del ejercicio en el momento del envío.
  contentRevision String?
  /**
   * True solo en el primer intento que aprobó (consistente con UserExerciseCompletion).
   */
  awardedXp       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, exerciseId, createdAt])
  /// Analytics por ventana temporal (el índice de arriba guía por userId
  /// y no sirve para "todos los envíos entre dos fechas").
  @@index([createdAt])
  @@index([exerciseId, createdAt])
  @@map("user_exercise_attempt")
}

// Marca atómica de "este usuario ya aprobó este ejercicio".
// Su UNIQUE (userId, exerciseId) es lo que evita doble XP por race condition:
// al intentar `create()`, solo el primer envío concurrente gana; los demás
// reciben P2002 y no se les otorga XP.
model UserExerciseCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, exerciseId])
  @@map("user_exercise_completion")
}

// =====================================================================
//  EJERCICIOS DE PRÁCTICA (independientes de lecciones)
// =====================================================================
//  Ejercicios sueltos que el alumno puede resolver para reforzar o
//  consolidar lo que vio en las unidades. NO están atados a un step ni
//  desbloquean nada — son práctica abierta.
//  La dificultad es RELATIVA a su unidad: un ejercicio "hard" de
//  arreglos no es comparable a un "hard" de cout; cada uno se mide
//  contra el material de su unidad.

model PracticeExercise {
  id           String     @id @default(cuid())
  /// Curso dueño del ejercicio. Sin él, dos cursos con una unidad llamada
  /// igual colisionarían y un intento podría colgarse del ejercicio de otro
  /// curso. Se derivó por backfill al curso C++ existente en la migración
  /// `add_course_language`.
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitSlug     String // contexto pedagógico: "primer-programa", "arreglos", etc.
  /// Unidad dueña, resuelta por (curso, slug de unidad). La relación compuesta
  /// hace imposible apuntar a la unidad de otro curso.
  unit         Unit       @relation(fields: [courseId, unitSlug], references: [courseId, slug], onDelete: Cascade)
  /// Único DENTRO del curso: `arreglos-suma` puede existir en C++ y en C#.
  slug         String
  title        String
  description  String
  prompt       String // markdown
  starterCode  String
  solutionCode String
  hints        String[]
  difficulty   Difficulty @default(easy)
  xpReward     Int        @default(15)
  position     Int        @default(0)
  published    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Hash corto del contenido vigente. Ver `src/lib/content-revision.ts`.
  contentRevision   String?
  contentRevisionAt DateTime?

  testCases     PracticeTestCase[]
  attempts      UserPracticeAttempt[]
  completions   UserPracticeCompletion[]
  hintsViewed   UserHintViewed[]
  bugReports    BugReport[]
  feedback      Feedback[]
  productEvents ProductEvent[]

  @@unique([courseId, slug])
  @@index([courseId, unitSlug, position])
  @@index([unitSlug, position])
  @@map("practice_exercise")
}

model PracticeTestCase {
  id             String           @id @default(cuid())
  exerciseId     String
  exercise       PracticeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  stdin          String           @default("")
  expectedStdout String
  visible        Boolean          @default(true)
  description    String?
  order          Int              @default(0)

  @@index([exerciseId, order])
  @@map("practice_test_case")
}

model UserPracticeAttempt {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        PracticeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  code            String
  passed          Boolean
  feedback        String?
  testsPassed     Int              @default(0)
  testsTotal      Int              @default(0)
  /// ⚠️ LATENCIA DEL EJECUTOR, no tiempo de resolución. Ver `UserExerciseAttempt.durationMs`.
  durationMs      Int?
  /// Revisión del contenido del ejercicio en el momento del envío.
  contentRevision String?
  /**
   * True solo en el primer intento que aprobó (consistente con UserPracticeCompletion).
   */
  awardedXp       Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([userId, exerciseId, createdAt])
  /// Analytics por ventana temporal. Ver `UserExerciseAttempt`.
  @@index([createdAt])
  @@index([exerciseId, createdAt])
  @@map("user_practice_attempt")
}

// Marca atómica de "este usuario ya aprobó este ejercicio de práctica".
// Análogo a UserExerciseCompletion: el UNIQUE evita XP duplicado en race.
model UserPracticeCompletion {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    PracticeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completedAt DateTime         @default(now())

  @@unique([userId, exerciseId])
  /// Funnel de práctica: aprobados dentro de una ventana.
  @@index([completedAt])
  @@map("user_practice_completion")
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime?
  totalXp        Int       @default(0)
  updatedAt      DateTime  @updatedAt

  @@map("user_streak")
}

// =====================================================================
//  SEÑALES PEDAGÓGICAS — sesiones, hints, reportes de contenido
// =====================================================================

// Sesión de estudio: una visita continua a un recurso (lección o ejercicio
// de práctica). La abre el cliente al montar el reproductor y la cierra al
// salir; si el cliente nunca cierra (cerró la pestaña, se quedó sin red), el
// barrido de huérfanas la cierra en `lastPingAt`.
//
// SEMÁNTICA DEL TIEMPO — leer antes de usar en un dashboard:
//   · `startedAt`..`endedAt` es TIEMPO DE PARED. NO es tiempo de estudio.
//   · `engagedMs` es tiempo ACTIVO APROXIMADO: la suma de los intervalos
//     entre heartbeats consecutivos, y el cliente sólo emite heartbeat si la
//     pestaña está visible y hubo actividad real (teclado/mouse/scroll) en la
//     ventana reciente. Cada intervalo se acota en el servidor a
//     `MAX_HEARTBEAT_CREDIT_MS`. El cierre acredita el último tramo SÓLO si
//     el cliente afirma actividad reciente (misma regla), así que una pestaña
//     abierta y olvidada termina en 0 — cerrar no es evidencia de estudiar.
//   · El reloj SIEMPRE es del servidor (`now()`); el cliente nunca manda
//     duraciones.
model StudySession {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * "lesson" | "practice".
   */
  surface     String
  /**
   * Referencia opcional al recurso (lessonId, practiceExerciseId, etc.).
   */
  resourceId  String?
  /**
   * Clave de idempotencia generada por el cliente (una por montaje del
   * reproductor). El UNIQUE (userId, clientKey) hace que React StrictMode,
   * un reintento de red o un doble click NO creen dos sesiones.
   */
  clientKey   String?
  startedAt   DateTime               @default(now())
  endedAt     DateTime?
  endedReason StudySessionEndReason?
  /**
   * Última señal de actividad; también es el cierre efectivo de una huérfana.
   */
  lastPingAt  DateTime               @default(now())
  /**
   * Tiempo activo aproximado acumulado, en ms. Ver nota de semántica arriba.
   */
  engagedMs   Int                    @default(0)

  hintsViewed   UserHintViewed[]
  productEvents ProductEvent[]

  @@unique([userId, clientKey])
  @@index([userId, startedAt])
  @@index([userId, surface, startedAt])
  @@index([surface, startedAt])
  @@index([lastPingAt])
  @@map("study_session")
}

enum StudySessionEndReason {
  /**
   * El cliente avisó que se iba (unmount, pagehide, navegación).
   */
  closed
  /**
   * Nadie avisó: el barrido la cerró por falta de heartbeats.
   */
  expired
}

// Una fila por (usuario, ejercicio, hint que vio). UNIQUE evita inflar
// stats por clicks repetidos en el mismo hint. Sirve para medir eficacia.
model UserHintViewed {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintIndex          Int
  /**
   * Solo uno de {exerciseId, practiceExerciseId} debe estar presente.
   */
  exerciseId         String?
  exercise           Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  practiceExerciseId String?
  practiceExercise   PracticeExercise? @relation(fields: [practiceExerciseId], references: [id], onDelete: Cascade)
  /**
   * Sesión de estudio en la que se reveló (para reconstruir la línea de tiempo).
   */
  studySessionId     String?
  studySession       StudySession?     @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  /**
   * Revisión del contenido del ejercicio cuando se reveló la pista.
   */
  contentRevision    String?
  viewedAt           DateTime          @default(now())

  @@unique([userId, exerciseId, hintIndex])
  @@unique([userId, practiceExerciseId, hintIndex])
  @@index([userId, viewedAt])
  /// Uso de pistas por ventana temporal (sin filtrar por usuario).
  @@index([viewedAt])
  @@map("user_hint_viewed")
}

// Reporte de problema en contenido (typo, test case roto, etc.). El alumno
// elige UN target: paso, ejercicio de lección o ejercicio de práctica.
model BugReport {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation("BugReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Solo uno de los tres debe estar presente — se valida vía CHECK constraint.
   */
  lessonStepId       String?
  lessonStep         LessonStep?       @relation(fields: [lessonStepId], references: [id], onDelete: SetNull)
  exerciseId         String?
  exercise           Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  practiceExerciseId String?
  practiceExercise   PracticeExercise? @relation(fields: [practiceExerciseId], references: [id], onDelete: SetNull)
  message            String
  status             ReportStatus      @default(open)
  /**
   * Evidencia del cierre: por qué se resolvió/descartó.
   */
  resolutionNote     String?
  /**
   * Issue de GitHub asociado (URL completa).
   */
  issueUrl           String?
  /**
   * PR que implementó el cambio (URL completa).
   */
  prUrl              String?
  triagedAt          DateTime?
  resolvedAt         DateTime?
  /**
   * Admin que movió el reporte por última vez.
   */
  handledById        String?
  handledBy          User?             @relation("BugReportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("bug_report")
}

/// Estado compartido por `BugReport` y `Feedback`. `open` → `triaged` →
/// `resolved` | `duplicate` | `wontfix`.
enum ReportStatus {
  open
  triaged
  resolved
  duplicate
  wontfix
}

// ---------------------------------------------------------------------
//  FEEDBACK GENERAL
// ---------------------------------------------------------------------
//  Distinto de BugReport: no apunta a un contenido roto concreto, sino a la
//  experiencia ("esto me confundió", "estaría bueno que..."). El contexto
//  (ruta, superficie, recurso) se captura solo — al alumno no se le pide
//  que describa dónde estaba.
model Feedback {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  kind               FeedbackKind
  message            String
  /**
   * Ruta de la app donde se abrió el widget, SIN query string ni fragmento.
   */
  path               String?
  surface            ProductSurface?
  lessonId           String?
  lesson             Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  practiceExerciseId String?
  practiceExercise   PracticeExercise? @relation(fields: [practiceExerciseId], references: [id], onDelete: SetNull)
  status             ReportStatus      @default(open)
  resolutionNote     String?
  issueUrl           String?
  prUrl              String?
  triagedAt          DateTime?
  resolvedAt         DateTime?
  handledById        String?
  handledBy          User?             @relation("FeedbackHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("feedback")
}

enum FeedbackKind {
  /**
   * "no entendí esto"
   */
  confusing
  /**
   * sugerencia / idea
   */
  idea
  /**
   * algo que le gustó
   */
  praise
  other
}

// ---------------------------------------------------------------------
//  EVENTOS DE PRODUCTO (append-only)
// ---------------------------------------------------------------------
//  Capa MÍNIMA para el comportamiento que NO se puede inferir de las tablas
//  de dominio. Todo lo que ya está bien representado (envíos, completions,
//  pistas, reportes) NO se duplica aquí.
//
//  Reglas:
//   · `name` es un enum cerrado — la taxonomía es explícita y limitada.
//   · `occurredAt` es hora del SERVIDOR. El cliente nunca manda timestamps.
//   · `props` se valida en el servidor con un contrato por evento
//     (`src/lib/analytics/events.ts`). No es un JSON libre.
//   · `dedupeKey` + UNIQUE (userId, dedupeKey) da idempotencia donde un
//     re-render, un reintento o un doble click podrían duplicar.
//   · NUNCA guardamos código fuente, teclas, ni texto libre del alumno aquí.
model ProductEvent {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               ProductEventName
  surface            ProductSurface
  /**
   * Recursos: FK reales (integridad referencial), nunca un id suelto.
   */
  lessonId           String?
  lesson             Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonStepId       String?
  lessonStep         LessonStep?       @relation(fields: [lessonStepId], references: [id], onDelete: SetNull)
  exerciseId         String?
  exercise           Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  practiceExerciseId String?
  practiceExercise   PracticeExercise? @relation(fields: [practiceExerciseId], references: [id], onDelete: SetNull)
  studySessionId     String?
  studySession       StudySession?     @relation(fields: [studySessionId], references: [id], onDelete: SetNull)
  /**
   * Revisión del contenido que el usuario tenía enfrente.
   */
  contentRevision    String?
  /**
   * Clave de idempotencia (null = evento sin dedupe).
   */
  dedupeKey          String?
  /**
   * Hora del servidor. Fuente autoritativa.
   */
  occurredAt         DateTime          @default(now())
  props              Json              @default("{}")

  @@unique([userId, dedupeKey])
  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([lessonId, name, occurredAt])
  @@index([exerciseId, name, occurredAt])
  @@index([practiceExerciseId, name, occurredAt])
  @@index([studySessionId])
  @@map("product_event")
}

enum ProductEventName {
  /**
   * Abrió el reproductor de una lección.
   */
  lesson_view
  /**
   * Primera interacción real dentro de la lección (no sólo abrirla).
   */
  lesson_engaged
  /**
   * Llegó a un paso concreto de la lección.
   */
  lesson_step_view
  /**
   * Intento pedagógico en un paso interactivo (quiz, fill_blank, ...).
   */
  lesson_step_attempt
  /**
   * Pidió ver la respuesta/solución de un paso.
   */
  lesson_step_answer_revealed
  /**
   * Abrió un ejercicio de práctica.
   */
  practice_view
  /**
   * Primera interacción real en el ejercicio de práctica.
   */
  practice_engaged
  /**
   * Compiló/ejecutó en el playground SIN calificar. Lo emite el servidor.
   */
  code_run
}

enum ProductSurface {
  lesson
  practice
  playground
  app
}

// ---------------------------------------------------------------------
//  REVISIONES DE CONTENIDO
// ---------------------------------------------------------------------
//  Bitácora append-only: cuándo apareció por primera vez cada revisión de un
//  paso/ejercicio. Con esto una comparación antes/después tiene ventanas
//  temporales defendibles (y no mezcla intentos de dos redacciones distintas).
//  Lo escribe el seed. No es un CMS: no versiona el contenido, sólo el hash.
model ContentRevision {
  id          String            @id @default(cuid())
  targetType  ContentTargetType
  targetId    String
  /**
   * Hash corto (sha256 truncado) del contenido.
   */
  revision    String
  firstSeenAt DateTime          @default(now())

  @@unique([targetType, targetId, revision])
  @@index([targetType, targetId, firstSeenAt])
  @@map("content_revision")
}

enum ContentTargetType {
  lesson
  lesson_step
  exercise
  practice_exercise
}

// =====================================================================
//  SOCIAL — amigos
// =====================================================================
//  Sistema de amistad bidireccional con flujo solicitud → aceptación.
//  Una fila por par (requester, addressee). El UNIQUE evita duplicados.
//  La UI traduce un par ACCEPTED en "amigos" sin importar quién mandó la
//  solicitud — `getFriends(userId)` une ambas direcciones.
//
//  Estados:
//    pending   — solicitud enviada, addressee aún no responde
//    accepted  — amistad activa
//    blocked   — addressee bloqueó al requester (no recibe más solicitudes
//                ni aparece su actividad). Bloqueo unidireccional: el
//                bloqueado sigue viendo su lado normal.
//
//  La unicidad (requesterId, addresseeId) impide que A pueda mandarle dos
//  solicitudes a B, pero NO bloquea que B también le mande a A
//  (race de solicitudes cruzadas). La server action `sendFriendRequest`
//  detecta el caso y auto-acepta.

model Friendship {
  id          String       @id @default(cuid())
  requesterId String
  requester   User         @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User         @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(pending)
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendship")
}

enum FriendStatus {
  pending
  accepted
  blocked
}

// =====================================================================
//  RATE LIMITING
// =====================================================================
//  Reemplaza el rate-limit en memoria de /api/run y de las acciones de
//  envío de ejercicios. Persistente y multi-instancia (serverless safe).
//  Estrategia: ventana fija — un row por (usuario, endpoint, minuto-utc).
//  Limpieza: las filas viejas se pueden purgar con un job; mientras tanto
//  son baratas (índice por windowStart).

model RateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String // "run" | "submit-lesson-exercise" | "submit-practice"
  windowStart DateTime // truncado al inicio de la ventana (minuto)
  count       Int      @default(1)

  @@unique([userId, endpoint, windowStart])
  @@index([windowStart])
  @@map("rate_limit")
}
