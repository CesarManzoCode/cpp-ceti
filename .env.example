# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Supabase: usa el pooler para DATABASE_URL y la conexión directa para DIRECT_URL.
DATABASE_URL="postgresql://postgres:[PASS]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASS]@[HOST]:5432/postgres"

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=""            # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""              # opcional; si pones uno, pon también el secret
GOOGLE_CLIENT_SECRET=""

# ─── Ejecución de C++ ─────────────────────────────────────────────────────────
# wandbox (default) · piston · piston-selfhosted · judge0-rapidapi · judge0-selfhosted
CODE_EXECUTOR_PROVIDER="wandbox"

# wandbox — API pública, sin llave. Opcionales:
WANDBOX_URL=""                   # default https://wandbox.org
WANDBOX_COMPILER=""              # default gcc-head
WANDBOX_COMPILER_OPTIONS=""

# piston / piston-selfhosted
PISTON_URL=""                    # obligatorio con piston-selfhosted (ej http://127.0.0.1:2000)
PISTON_CPP_VERSION=""

# judge0-rapidapi / judge0-selfhosted
JUDGE0_RAPIDAPI_KEY=""
JUDGE0_RAPIDAPI_HOST="judge0-ce.p.rapidapi.com"
JUDGE0_SELFHOSTED_URL=""         # ej http://123.45.67.89:2358
JUDGE0_AUTH_TOKEN=""
JUDGE0_CPP_LANGUAGE_ID=""        # numérico; sólo si tu instancia usa otro id
